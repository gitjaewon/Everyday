# Production (EC2): the server's public domain/IP, reachable from the user's browser (HTTPS required)
EXPO_PUBLIC_API_URL=https://api.example.com

# Web and iOS simulator (FastAPI exposed by docker-compose)
# EXPO_PUBLIC_API_URL=http://localhost:8000
# Android Emulator uses the host alias instead:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# Physical devices should use your development machine's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
